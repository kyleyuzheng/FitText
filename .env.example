# =============================================================================
# FitText -- .env.example
# Copy to .env (gitignored) and fill in. All values below are placeholders.
# Shell entry points read these from the environment; Python reads them via
# os.environ at call time.
# =============================================================================

# ----- Core credentials ------------------------------------------------------
# Used by inference (qa_pipeline_open_domain.py), corpus builders, the virtual
# API server (server/config.yml expands ${OPENAI_API_KEY}), and ToolRet.
OPENAI_API_KEY=REPLACE_WITH_OPENAI_API_KEY

# The StableToolBench judge (toolbench/tooleval) reads OPENAI_KEY, not
# OPENAI_API_KEY. Set it to the same value.
OPENAI_KEY=REPLACE_WITH_OPENAI_API_KEY
# Optional evaluator key-pool extras:
# OPENAI_ORG=
# OPENAI_TYPE=
# OPENAI_VER=
# Optional: path to a JSON list of {"api_key": ...} entries to round-robin
# judge calls across multiple keys (leave unset to use OPENAI_KEY):
# API_POOL_FILE=./openai_key.json

# Only needed when running claude-* solver models:
# ANTHROPIC_API_KEY=REPLACE_WITH_ANTHROPIC_API_KEY

# Key sent to the (local) virtual API server. Any non-empty string works for
# the local simulator:
TOOLBENCH_KEY=REPLACE_ME

# ----- StableToolBench services ----------------------------------------------
# Virtual tool-API simulator (scripts/run_server.sh serves POST /virtual :8080):
SERVICE_URL=http://localhost:8080/virtual
# Optional shared SimCSE retriever server (scripts/run_retriever_server.sh);
# unset = each inference process loads the retriever locally:
# RETRIEVER_SERVER_URL=http://localhost:8090

# ----- Data locations ----------------------------------------------------------
# RapidAPI tool JSON corpus from the ToolBench data release (see SETUP):
TOOL_ROOT_DIR=./data/toolenv/tools
# StableToolBench retrieval corpora ({G1,G2,G3}/des_corpus.json):
CORPUS_BASE_DIR=./data/retrieval/StableToolBench
# Raw inference output root:
# OUTPUT_ROOT=./runs/stb/raw_output
# StableToolBench data root for auxiliary scripts:
# STB_DATA_ROOT=./StableToolBench/data

# ----- Local vLLM (open-weight solvers: Qwen / DeepSeek / Gemma) ----------------
# VLLM_BASE_URL=http://localhost:8000/v1
# VLLM_API_KEY=EMPTY
# VLLM_MODEL_CTX=32768

# ----- OpenAI client tuning (optional) ------------------------------------------
# Force Chat Completions for gpt-5.x instead of the Responses API:
# OPENAI_FORCE_CHAT_COMPLETIONS=1
# OPENAI_MAX_COMPLETION_TOKENS=4096
# Reasoning effort for gpt-5.x solvers (none|low|medium|high):
# OPENAI_REASONING_EFFORT=medium

# ----- Evaluation (StableToolBench tooleval) -------------------------------------
# Evaluator config dir under StableToolBench/toolbench/tooleval/evaluators/.
# Defaults to the judge pinned in configs/model_pins.yaml:
# STB_EVALUATOR=tooleval_judge_default
# Override the judge model pin without editing configs/model_pins.yaml:
# STB_JUDGE_MODEL=
# EVAL_MODEL=
# Knobs read by scripts/run_evaluation.sh:
# MAX_EVAL_THREADS=1
# EVALUATE_TIMES=3
# RAW_ANSWER_PATH=./runs/stb/raw_output
# CONVERTED_ANSWER_PATH=./runs/stb/model_predictions_converted
# PASS_RATE_SAVE_PATH=./runs/stb/pass_rate_results
# TEST_IDS_DIR=./StableToolBench/solvable_queries/test_query_ids

# ----- Runner / infra -------------------------------------------------------------
# Root used by ${WORKSPACE_ROOT} substitution in configs/_base/*.yaml:
WORKSPACE_ROOT=.
FITTEXT_RUNTIME_ROOT=./runs
FITTEXT_ANALYSIS_ROOT=./runs/analysis
# JOB_ID=fittext_local
# EMBEDDER_DEVICE=cuda:0
# CUDA_VISIBLE_DEVICES=0
# TOKENIZERS_PARALLELISM=false

# ----- Baselines (optional) ----------------------------------------------------
# COLT (cloned by scripts/setup_colt.sh into baselines/external/, gitignored):
# COLT_PATH=./baselines/external/COLT
# COLT_CKPT=./baselines/external/COLT/checkpoint
# COLT_DEVICE=cuda:0
# COLT_DATASET=toolret
# COLT_RUN_INTEGRATION=0
# Re-Invoke retriever (index pre-built via baselines/build_reinvoke_stb_index.py):
# REINVOKE_CACHE_DIR=./runs/reinvoke/cache
# REINVOKE_K_SYNTH=10
# REINVOKE_MAX_INTENTS=3
# REINVOKE_INDEX_CONCURRENCY=8
# REINVOKE_REQUIRE_PREBUILT=1

# ----- ToolRet sweep drivers (optional) -----------------------------------------
# TOOLRET_OUTPUT_ROOT=./runs/toolret
# TOOLRET_CONCURRENCY=8

# ----- Tests ---------------------------------------------------------------------
# FITTEXT_E2E_GPU=0          # 1 = allow GPU in e2e tests
# RUN_BASELINE_REPRODUCTION=0
# REPRO_MODEL=
